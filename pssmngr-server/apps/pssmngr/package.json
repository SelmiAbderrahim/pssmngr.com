{
	"name": "pssmngr-app",
	"version": "1.0.0",
	"description": "Web API for the pssmngr zero-knowledge password manager",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/SelmiAbderrahim/pssmngr.com.git",
		"directory": "pssmngr-server/apps/pssmngr"
	},
	"bugs": {
		"url": "https://github.com/SelmiAbderrahim/pssmngr.com/issues"
	},
	"homepage": "https://github.com/SelmiAbderrahim/pssmngr.com/tree/main/pssmngr-server/apps/pssmngr#readme",
	"scripts": {
		"build": "pnpm run build-server && pnpm run build-next",
		"build-server": "tsx esbuild.config.ts",
		"build-next": "next build --webpack",
		"start": "node -r dotenv/config dist/server.mjs",
		"dev": "tsx -r dotenv/config ./server/server.ts --project tsconfig.server.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint",
		"format": "biome format --write",
		"test": "vitest run --config __test__/vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"migration:generate": "drizzle-kit generate --config ./server/db/drizzle.config.ts",
		"migration:run": "tsx -r dotenv/config migration.ts",
		"db:push": "drizzle-kit push --config ./server/db/drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config ./server/db/drizzle.config.ts",
		"db:truncate": "tsx -r dotenv/config ./server/db/reset.ts",
		"reset-2fa": "node -r dotenv/config dist/reset-2fa.mjs"
	},
	"dependencies": {
		"@better-auth/passkey": "~1.6.25",
		"@pssmngr/server": "workspace:*",
		"@trpc/server": "^10.45.3",
		"adm-zip": "^0.6.0",
		"bcrypt": "6.0.0",
		"better-auth": "~1.6.25",
		"better-auth-localization": "^3.0.0",
		"dotenv": "16.4.5",
		"drizzle-orm": "^0.45.2",
		"i18next": "^23.16.8",
		"i18next-fs-backend": "^2.6.6",
		"ioredis": "6.0.0",
		"nanoid": "3.3.11",
		"next": "^16.2.12",
		"node-schedule": "2.1.1",
		"nodemailer": "9.0.3",
		"pino": "9.4.0",
		"postgres": "3.4.4",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"resend": "^4.0.0",
		"slugify": "^1.6.6",
		"superjson": "^2.2.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bcrypt": "5.0.2",
		"@types/node": "^20.19.0",
		"@types/react": "^18.3.5",
		"@types/react-dom": "^18.3.0",
		"@vitest/coverage-v8": "3.2.6",
		"drizzle-kit": "^0.31.10",
		"esbuild": "0.28.1",
		"tsx": "^4.16.2",
		"typescript": "^5.8.3",
		"vite-tsconfig-paths": "4.3.2",
		"vitest": "3.2.6"
	},
	"packageManager": "pnpm@9.12.0",
	"engines": {
		"node": "^20.19.0",
		"pnpm": ">=9.12.0"
	}
}
