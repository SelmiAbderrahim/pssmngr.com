{
  "name": "@pssmngr/server",
  "version": "1.0.0",
  "description": "Backend library for the pssmngr zero-knowledge password manager",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./db": {
      "import": "./dist/db/index.js"
    },
    "./db/schema": {
      "import": "./dist/db/schema/index.js"
    },
    "./constants": {
      "import": "./dist/constants/index.js"
    },
    "./jobs": {
      "import": "./dist/jobs/index.js"
    },
    "./services/data-export": {
      "import": "./dist/services/data-export/index.js"
    },
    "./*": {
      "import": "./dist/*.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SelmiAbderrahim/pssmngr.com.git",
    "directory": "pssmngr-server/packages/server"
  },
  "bugs": {
    "url": "https://github.com/SelmiAbderrahim/pssmngr.com/issues"
  },
  "scripts": {
    "build": "pnpm run i18n:generate-types && rm -rf ./dist && tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json && cp -r src/i18n/locales dist/i18n/locales",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../apps/pssmngr/__test__/vitest.config.ts src",
		"i18n:generate-types": "tsx src/i18n/scripts/generate-types.ts && biome format --write src/i18n/types.generated.ts",
    "i18n:check": "vitest run src/i18n/__tests__/translation-completeness.test.ts --config ../../apps/pssmngr/__test__/vitest.config.ts",
    "i18n:report": "tsx scripts/translation-report.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "~1.6.25",
    "@trpc/server": "^10.45.3",
    "adm-zip": "^0.6.0",
    "bcrypt": "6.0.0",
    "better-auth": "~1.6.25",
    "better-auth-localization": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "i18next": "^23.16.8",
    "i18next-fs-backend": "^2.6.6",
    "ioredis": "5.4.1",
    "nanoid": "3.3.11",
    "node-schedule": "2.1.1",
    "nodemailer": "9.0.3",
    "pino": "9.4.0",
    "postgres": "3.4.4",
    "resend": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "5.0.2",
    "@types/node": "^20.19.0",
    "@types/node-schedule": "2.1.6",
    "@types/nodemailer": "^8.0.1",
    "tsc-alias": "1.8.10",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^20.19.0",
    "pnpm": ">=9.12.0"
  }
}
