# Public URL served by the host reverse proxy. Do not include a trailing slash.
SITE_URL=http://localhost:42789

# Local host ports used by the example Nginx configuration.
CLIENT_PORT=42789
SERVER_PORT=39291

# PostgreSQL. Use a URL-safe password because Compose embeds it in DATABASE_URL.
POSTGRES_DB=pssmngr
POSTGRES_USER=pssmngr
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value

# Redis authentication.
REDIS_PASSWORD=replace-with-a-different-long-random-value

# Server-only secrets. Generate separate values; never reuse the master password.
# BETTER_AUTH_SECRET signs authentication state.
# ENCRYPTION_KEY signs anti-enumeration and emergency-access metadata. It cannot
# decrypt vault items; vault encryption remains entirely client-side.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-different-random-characters

# Additional browser origins, comma-separated. Leave blank for same-origin use.
TRUSTED_ORIGINS=

# Keep false for a normal self-hosted installation.
IS_CLOUD=false

# Optional transactional email. With no complete provider configuration,
# email-dependent actions return a clear configuration error.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional WebAuthn/passkey overrides. Defaults are suitable only for localhost.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=pssmngr
PASSKEY_ORIGIN=http://localhost:42789

# Optional privacy-preserving aggregate analytics. Never include user or vault data.
VITE_GA_MEASUREMENT_ID=

# Reproducible build toolchain defaults.
NODE_VERSION=20.19.0
PNPM_VERSION=9.12.0
