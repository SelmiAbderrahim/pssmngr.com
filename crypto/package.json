{
  "name": "@pssmngr/crypto",
  "version": "1.0.0",
  "description": "Zero-knowledge encryption SDK for pssmngr password manager",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./key-derivation": {
      "import": {
        "types": "./dist/key-derivation.d.ts",
        "default": "./dist/key-derivation.js"
      },
      "require": {
        "types": "./dist/key-derivation.d.cts",
        "default": "./dist/key-derivation.cjs"
      }
    },
    "./vault": {
      "import": {
        "types": "./dist/vault.d.ts",
        "default": "./dist/vault.js"
      },
      "require": {
        "types": "./dist/vault.d.cts",
        "default": "./dist/vault.cjs"
      }
    },
    "./envelope": {
      "import": {
        "types": "./dist/envelope.d.ts",
        "default": "./dist/envelope.js"
      },
      "require": {
        "types": "./dist/envelope.d.cts",
        "default": "./dist/envelope.cjs"
      }
    },
    "./keypair": {
      "import": {
        "types": "./dist/keypair.d.ts",
        "default": "./dist/keypair.js"
      },
      "require": {
        "types": "./dist/keypair.d.cts",
        "default": "./dist/keypair.cjs"
      }
    },
    "./sharing": {
      "import": {
        "types": "./dist/sharing.d.ts",
        "default": "./dist/sharing.js"
      },
      "require": {
        "types": "./dist/sharing.d.cts",
        "default": "./dist/sharing.cjs"
      }
    },
    "./ephemeral": {
      "import": {
        "types": "./dist/ephemeral.d.ts",
        "default": "./dist/ephemeral.js"
      },
      "require": {
        "types": "./dist/ephemeral.d.cts",
        "default": "./dist/ephemeral.cjs"
      }
    },
    "./shared-vault": {
      "import": {
        "types": "./dist/shared-vault.d.ts",
        "default": "./dist/shared-vault.js"
      },
      "require": {
        "types": "./dist/shared-vault.d.cts",
        "default": "./dist/shared-vault.cjs"
      }
    },
    "./recovery": {
      "import": {
        "types": "./dist/recovery.d.ts",
        "default": "./dist/recovery.js"
      },
      "require": {
        "types": "./dist/recovery.d.cts",
        "default": "./dist/recovery.cjs"
      }
    },
    "./escrow": {
      "import": {
        "types": "./dist/escrow.d.ts",
        "default": "./dist/escrow.js"
      },
      "require": {
        "types": "./dist/escrow.d.cts",
        "default": "./dist/escrow.cjs"
      }
    },
    "./random": {
      "import": {
        "types": "./dist/random.d.ts",
        "default": "./dist/random.js"
      },
      "require": {
        "types": "./dist/random.d.cts",
        "default": "./dist/random.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "benchmark:kdf": "vitest run --config vitest.benchmark.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "encryption",
    "password-manager",
    "zero-knowledge",
    "xchacha20-poly1305",
    "argon2id",
    "crypto",
    "x25519",
    "ed25519"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SelmiAbderrahim/pssmngr.git",
    "directory": "crypto"
  },
  "bugs": {
    "url": "https://github.com/SelmiAbderrahim/pssmngr/issues"
  },
  "homepage": "https://github.com/SelmiAbderrahim/pssmngr/tree/main/crypto#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "argon2-browser": "^1.18.0",
    "libsodium-sumo": "^0.7.16",
    "libsodium-wrappers-sumo": "^0.7.15"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "vite": "6.4.3"
    }
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "^20.19.0",
    "pnpm": ">=9.12.0"
  }
}
