{
  "name": "@pssmngr/client",
  "description": "Password Manager - React Frontend",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SelmiAbderrahim/pssmngr.git",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/SelmiAbderrahim/pssmngr/issues"
  },
  "homepage": "https://github.com/SelmiAbderrahim/pssmngr/tree/main/client#readme",
  "keywords": [
    "password-manager",
    "zero-knowledge",
    "react",
    "vite",
    "self-hosted",
    "agpl"
  ],
  "scripts": {
    "start": "pnpm run dev",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:frontend": "vite",
    "predev": "echo 'Starting development server...'",
    "build": "tsc -b && vite build",
    "build:prod": "vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:strict": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "serve": "serve dist -l 5173 -s",
    "test": "pnpm run test:unit",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "for s in 1 2 3 4 5 6 7 8; do NODE_OPTIONS=--max-old-space-size=4096 vitest run --shard=$s/8 || exit 1; done",
    "test:unit:all": "vitest run",
    "test:unit:watch": "vitest --coverage --reporter=verbose",
    "test:unit:ui": "vitest --ui --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report coverage/e2e/report",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "coverage": "vitest run --coverage && open coverage/index.html",
    "coverage:report": "vitest run --coverage --reporter=json && npx nyc report --reporter=html",
    "test:ci": "pnpm run test:unit",
    "test:validate": "pnpm run typecheck && pnpm run lint && pnpm run test:ci && pnpm run build",
    "test:quick": "vitest run --reporter=verbose",
    "pre-commit": "pnpm run typecheck && pnpm run lint && pnpm run test:quick",
    "pre-push": "pnpm run test:validate",
    "test:smoke": "vitest run --reporter=verbose",
    "rtl:check": "node scripts/rtl-responsive-check.cjs",
    "rtl:check:staged": "node scripts/rtl-responsive-check.cjs --staged",
    "audit:external-links": "vite-node scripts/audit-external-links.ts",
    "responsive:check": "node scripts/responsive-check.cjs",
    "responsive:check:staged": "node scripts/responsive-check.cjs --staged",
    "responsive:check:verbose": "node scripts/responsive-check.cjs --verbose",
    "design:check": "pnpm run rtl:check && pnpm run responsive:check",
    "design:check:staged": "pnpm run rtl:check:staged && pnpm run responsive:check:staged"
  },
  "dependencies": {
    "@better-auth/passkey": "~1.6.25",
    "@epic-web/client-hints": "^1.3.2",
    "@hookform/resolvers": "^5.2.2",
