    "@axe-core/playwright": "^4.9.1",
    "@eslint/js": "^9.8.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.56.1",
    "@tanstack/router-devtools": "^1.45.11",
    "@tanstack/router-plugin": "^1.45.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
